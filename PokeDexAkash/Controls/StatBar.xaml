<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PokeDexAkash.Controls.StatBar">
    <Grid x:Name="Root" HeightRequest="10" HorizontalOptions="Fill">
        <Border x:Name="Track" StrokeShape="RoundRectangle 5" BackgroundColor="#26FFFFFF" />
        <Border x:Name="Fill" StrokeShape="RoundRectangle 5" HorizontalOptions="Start" WidthRequest="0" BackgroundColor="White" />
    </Grid>
</ContentView>
